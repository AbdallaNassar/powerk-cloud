# powerk — files that should never be committed

# ---- Python ----
__pycache__/
*.py[cod]
*.log

# ---- secrets ----
# tokens / passwords / local credentials (pass them on the command line instead)
*.secret
*.token
.env

# ---- Android build output ----
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/baselineprofile/build/
android/local.properties
android/keystore.properties
android/app/google-services.json
android/.idea/
android/*.iml
android/captures/
*.apk
*.aab
*.keystore
*.jks

# ---- editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini


# ---- powerk runtime data (names, rules, settings incl. push tokens, energy history) ----
powerk.json
powerk.json.tmp
powerk.db

# ---- packaged Python server ----
server/.venv/
.pytest_cache/
*.egg-info/
.pytest-tmp/

# ---- production deployment ----
/deploy/.env
/deploy/certs/*.pem
/deploy/certs/*.key
/deploy/backups/
/deploy/apk/
/deploy/secrets/
