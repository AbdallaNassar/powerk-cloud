# Copy to .env; chmod 600 .env. Compose reads this file (do not source it).
# Public hostname that Cloudflare proxies to Caddy; must match the Origin certificate.
POWERK_DOMAIN=powerk.example.com
# Server IPv4 shown in the UI and the provisioning hint (empty: auto-detect).
POWERK_IP=203.0.113.10
# Optional extra MAC allowlist (comma separated); ownership uses claims. Leave empty to skip.
POWERK_MAC=
# Optional legacy shared token with full strip access. Leave empty for an account-only install.
# Generate with: openssl rand -hex 32
POWERK_TOKEN=
# Optional FCM: install this file as described in deploy/README.md, or leave the value empty to disable.
POWERK_FCM_SERVICE_ACCOUNT=/secrets/firebase-service-account.json
# Shell-style argument quoting, parsed by Python shlex (never evaluated as a shell).
# Registration is open by default; add --no-open-registration to close it.
# Do not override --data, --web-port or --port: mounts/proxy/healthcheck use these.
POWERK_ARGS=--secure-cookies
